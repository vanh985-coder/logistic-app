# Copy to infra/.env.prod and replace every value. Never commit the real file.
# Use only letters and digits in passwords (they are embedded in connection URLs).
# Generate a random value with:  openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=logix
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=logix3d_db

# --- Redis ---
REDIS_PASSWORD=change_me_redis

# --- MinIO (object storage) ---
MINIO_ROOT_USER=logix_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_min_8_chars
MINIO_BUCKET_PROOFS=loading-proofs
# Address browsers use to open presigned download links, e.g. https://files.example.com
# or http://<server-ip>:9000. Leave empty only if nobody downloads proof images.
MINIO_PUBLIC_URL=
# Host interface/port for MinIO's S3 API. Use 127.0.0.1 when a reverse proxy fronts it.
MINIO_PUBLIC_BIND=0.0.0.0
MINIO_PUBLIC_PORT=9000

# --- API ---
# At least 32 random characters
JWT_SECRET=change_me_to_a_long_random_string
# Public URL of the web app (CORS whitelist). Comma-separate multiple origins.
WEB_URL=https://app.example.com
LOG_LEVEL=info

# --- Web ---
# Use WEB_BIND=127.0.0.1 when Nginx/Caddy on the same host terminates HTTPS.
WEB_BIND=0.0.0.0
WEB_PORT=3000
