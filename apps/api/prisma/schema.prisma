datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CompanyType {
  SHIPPER
  FWD
  CFS
}

enum CompanyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  COMPANY_ADMIN
  SHIPPER_ADMIN
  SHIPPER_MEMBER
  FWD_ADMIN
  FWD_OPERATOR
  CFS_ADMIN
  CFS_OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id                 String        @id @default(uuid())
  taxCode            String        @unique
  name               String
  type               CompanyType
  status             CompanyStatus @default(PENDING)
  address            String?
  phone              String?
  email              String?
  website            String?
  representativeName String?
  metadata           Json?
  verifiedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  users              User[]
  shipments          Shipment[]
  packages           Package[]
  matchGroupShipments MatchGroupShipment[]
  quotes             Quote[]               @relation("FwdQuotes")
  bookings           Booking[]             @relation("FwdBookings")
  cfsBookings        Booking[]             @relation("CfsBookings")
  loadingProofs      LoadingProof[]

  @@index([status, createdAt(sort: Desc)])
  @@map("companies")
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  fullName     String?
  phone        String?
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum ShipmentStatus {
  DRAFT
  PRICED
  SUBMITTED
  MATCHING
  GROUPED
  CONFIRMED
  RECEIVED_CFS
  SEALED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  RECEIVED_CFS
  SEALED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PackageType {
  BOX
  PALLET
  CRATE
  OTHER
}

enum ChargeableBasis {
  VOLUME
  WEIGHT
}

model Lane {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  origin         String
  destination    String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  pricingConfigs PricingConfig[]
  shipments      Shipment[]
  matchGroups    MatchGroup[]

  @@map("lanes")
}

model PricingConfig {
  id                    String    @id @default(uuid())
  laneId                String
  lane                  Lane      @relation(fields: [laneId], references: [id], onDelete: Cascade)
  version               Int       @default(1)
  cbmRate               BigInt
  weightRateKg          BigInt
  fixedFee              BigInt    @default(0)
  standardSurchargeBps  Int       @default(10000)
  irregularSurchargeBps Int       @default(11500)
  noStackSurchargeBps   Int       @default(13000)
  maxEdgeRatioThreshold Int       @default(5)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shipments             Shipment[]

  @@index([laneId])
  @@index([laneId, effectiveTo])
  @@map("pricing_configs")
}

model Shipment {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  laneId           String
  lane             Lane            @relation(fields: [laneId], references: [id])
  pricingConfigId  String
  pricingConfig    PricingConfig   @relation(fields: [pricingConfigId], references: [id])
  trackingCode     String          @unique
  status           ShipmentStatus  @default(DRAFT)
  totalPackages    Int             @default(0)
  volumeMm3        BigInt          @default(0)
  weightGrams      BigInt          @default(0)
  chargeableBasis  ChargeableBasis @default(VOLUME)
  baseAmount       BigInt          @default(0)
  surchargedAmount BigInt          @default(0)
  totalAmount      BigInt          @default(0)
  pricingSnapshot  Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  packages         Package[]
  matchGroupShipments MatchGroupShipment[]
  loadingProofs    LoadingProof[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([laneId])
  @@map("shipments")
}

model Package {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packageCode String
  lengthMm    Int
  widthMm     Int
  heightMm    Int
  volumeMm3   BigInt
  weightGrams Int
  isFragile   Boolean     @default(false)
  noStack     Boolean     @default(false)
  dropOrder   Int?
  packageType PackageType @default(BOX)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId, shipmentId])
  @@index([shipmentId])
  @@map("packages")
}

enum MatchGroupStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  CLOSED
  CANCELLED
}

model ContainerType {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  innerLengthMm  Int
  innerWidthMm   Int
  innerHeightMm  Int
  volumeMm3      BigInt
  maxPayloadGram BigInt
  tareWeightGram BigInt
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  matchGroups    MatchGroup[]

  @@map("container_types")
}

model MatchGroup {
  id                    String              @id @default(uuid())
  code                  String              @unique
  laneId                String
  lane                  Lane                @relation(fields: [laneId], references: [id])
  targetContainerTypeId String
  targetContainerType   ContainerType       @relation(fields: [targetContainerTypeId], references: [id])
  status                MatchGroupStatus    @default(PROPOSED)
  cutoffTime            DateTime?
  totalCbmMm3           BigInt              @default(0)
  totalWeightGrams      BigInt              @default(0)
  volumeFillBps         Int                 @default(0)
  weightFillBps         Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  matchGroupShipments   MatchGroupShipment[]
  quotes                Quote[]
  bookings              Booking[]
  loadingProofs         LoadingProof[]

  @@index([laneId, status])
  @@map("match_groups")
}

model MatchGroupShipment {
  id                 String     @id @default(uuid())
  companyId          String
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchGroupId       String
  matchGroup         MatchGroup @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  shipmentId         String
  shipment           Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  dropOrder          Int        @default(1)
  deliveryDestination String?
  actualPackageCount Int?
  isDiscrepant       Boolean    @default(false)
  discrepancyReason  String?
  tallyStatus        String     @default("PENDING")
  tallyAt            DateTime?
  joinedAt           DateTime   @default(now())

  @@unique([matchGroupId, shipmentId])
  @@index([companyId, matchGroupId])
  @@index([matchGroupId])
  @@index([shipmentId])
  @@map("match_group_shipments")
}

model Quote {
  id               String       @id @default(uuid())
  matchGroupId     String
  matchGroup       MatchGroup   @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  fwdCompanyId     String
  fwdCompany       Company      @relation("FwdQuotes", fields: [fwdCompanyId], references: [id], onDelete: Cascade)
  status           QuoteStatus  @default(PENDING)
  oceanFreight     BigInt
  handlingFee      BigInt
  documentationFee BigInt
  surcharges       BigInt
  vatRateBps       Int          @default(1000)
  vatAmount        BigInt
  totalAmount      BigInt
  transitDays      Int
  validUntil       DateTime
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  bookings         Booking[]

  @@index([matchGroupId, status])
  @@index([fwdCompanyId])
  @@map("quotes")
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  matchGroupId  String
  matchGroup    MatchGroup    @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id])
  fwdCompanyId  String
  fwdCompany    Company       @relation("FwdBookings", fields: [fwdCompanyId], references: [id], onDelete: Cascade)
  cfsCompanyId  String?
  cfsCompany    Company?      @relation("CfsBookings", fields: [cfsCompanyId], references: [id])
  status        BookingStatus @default(CONFIRMED)
  totalAmount   BigInt
  containerNo   String?
  sealNo        String?
  sealedAt      DateTime?
  notes         String?
  confirmedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  loadingProofs LoadingProof[]

  @@index([matchGroupId])
  @@index([fwdCompanyId])
  @@index([cfsCompanyId])
  @@map("bookings")
}

enum LoadingProofType {
  INBOUND_INSPECTION
  LAYER_PACKED
  SEAL_CLOSED
}

model LoadingProof {
  id           String           @id @default(uuid())
  bookingId    String
  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  matchGroupId String
  matchGroup   MatchGroup       @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  shipmentId   String?
  shipment     Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proofType    LoadingProofType
  layerIndex   Int?
  fileKey      String
  fileName     String
  fileSize     Int
  mimeType     String
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([bookingId, proofType])
  @@index([matchGroupId])
  @@index([shipmentId])
  @@index([companyId])
  @@map("loading_proofs")
}


