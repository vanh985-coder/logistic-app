# ==============================================================================
# LOGIX-3D ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the application: cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
WEB_PORT=3000

# Client URLs (CORS Whitelist)
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# PostgreSQL Database (Direct and Pooled connections)
POSTGRES_USER=logix
POSTGRES_PASSWORD=logix_secret_dev
POSTGRES_DB=logix3d_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://logix:logix_secret_dev@localhost:5432/logix3d_db?schema=public&connection_limit=20"
# Used in production with PgBouncer
# DIRECT_URL="postgresql://logix:logix_secret_dev@localhost:5432/logix3d_db?schema=public"

# Redis (Caching, Rate Limiting, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# BullMQ Packing Queue
BULL_PREFIX=logix3d_queue

# MinIO (S3 Compatible Storage for Loading Proofs and Documents)
MINIO_ROOT_USER=logix_minio_admin
MINIO_ROOT_PASSWORD=logix_minio_secret_key
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_PROOFS=loading-proofs
MINIO_BUCKET_DOCS=business-documents
MINIO_USE_SSL=false

# Authentication & JWT Security
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=debug
# SENTRY_DSN=
# PROMETHEUS_METRICS_ENABLED=true
